ANTHROPIC_API_KEY=
FLY_API_TOKEN=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
AGENT_ENV=dev
GITHUB_TOKEN=
GITHUB_USERNAME=

# Cloudflare AI Gateway (optional)
# When CF_ACCOUNT_ID and CF_AI_GATEWAY_ID are both set, all LLM calls are routed
# through the gateway instead of calling the AI provider directly.
# This enables analytics, caching, rate limiting, and model fallback.
# Supported providers: https://developers.cloudflare.com/ai-gateway/usage/providers/
CF_ACCOUNT_ID=
CF_AI_GATEWAY_ID=
CF_AI_PROVIDER=anthropic
