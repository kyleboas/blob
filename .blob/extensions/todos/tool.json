{
  "name": "todos",
  "description": "Local todo/issue tracker for the agent. Manage tasks, bugs, and feature requests.",
  "input_schema": {
    "type": "object",
    "properties": {
      "command": {
        "type": "string",
        "enum": ["add", "list", "done", "remove", "search"],
        "description": "Action to perform"
      },
      "text": {
        "type": "string",
        "description": "Task text (for add/search)"
      },
      "id": {
        "type": "string",
        "description": "Task ID (for done/remove)"
      },
      "tag": {
        "type": "string",
        "description": "Filter by tag (bug, feature, task)"
      }
    },
    "required": ["command"]
  }
}
