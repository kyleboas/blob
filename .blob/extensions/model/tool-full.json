{
  "name": "model",
  "description": "Select LLM model for task. Usage: model --command pick --task 'fix bug' (auto-selects), model --command switch --model complex (manual), model --command list (see options)",
  "input_schema": {
    "type": "object",
    "properties": {
      "command": {
        "type": "string",
        "enum": ["list", "pick", "switch", "auto", "info"],
        "description": "Command to execute"
      },
      "task": {
        "type": "string",
        "description": "Task description for pick command"
      },
      "model": {
        "type": "string",
        "enum": ["chat", "routine", "complex"],
        "description": "Model to switch to"
      }
    },
    "required": ["command"]
  }
}
