{
  "budget": {
    "monthly_limit": 20,
    "currency": "USD",
    "alert_at": 15
  },
  "providers": {
    "cloudflare": {
      "name": "Cloudflare Workers AI",
      "models": {
        "qwen3-30b": {
          "id": "@cf/qwen/qwen3-30b-a3b-fp8",
          "cost_per_1k": 0.0005,
          "neurons": 120,
          "use_for": "default coding tasks"
        },
        "glm-4.7": {
          "id": "@cf/zai-org/glm-4.7-flash", 
          "cost_per_1k": 0.0002,
          "neurons": 50,
          "use_for": "simple queries"
        }
      }
    },
    "openai": {
      "name": "OpenAI via AI Gateway",
      "models": {
        "gpt-4.1-mini": {
          "id": "gpt-4.1-mini",
          "cost_per_1k_input": 0.0004,
          "cost_per_1k_output": 0.0016,
          "use_for": "when Cloudflare fails"
        }
      }
    },
    "anthropic": {
      "name": "Anthropic via AI Gateway",
      "models": {
        "claude-sonnet-4-6": {
          "id": "claude-sonnet-4-6",
          "cost_per_1k_input": 0.003,
          "cost_per_1k_output": 0.015,
          "use_for": "complex problems only"
        }
      }
    }
  },
  "strategy": {
    "default": "cloudflare/qwen3-30b",
    "fallback": "openai/gpt-4.1-mini",
    "escalate": "anthropic/claude-sonnet-4-6"
  },
  "cost_tracking": {
    "month": "2025-02",
    "spent": 0,
    "requests": 0
  }
}
